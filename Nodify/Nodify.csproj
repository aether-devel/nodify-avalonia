<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Authors>miroiu, bandysc, aether-devel</Authors>
    <Company>Aether</Company>
    <PackageId>Aether.NodifyAvalonia</PackageId>
    <Product>Aether.NodifyAvalonia</Product>
    <Description>The core controls for a node based editor (designed for MVVM) for Avalonia 12 / .NET 10. Maintained fork of NodifyAvalonia.</Description>
    <Copyright>Miroiu Emanuel</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/aether-devel/nodify-avalonia</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/aether-devel/nodify-avalonia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>avalonia mvvm node network node-editor graph controls</PackageTags>
    <Version>7.0.0</Version>
    <PackageReleaseNotes>
      > - Breaking Changes:
      >	  - Package renamed to Aether.NodifyAvalonia (maintained fork of NodifyAvalonia)
      >	  - Requires Avalonia 12 and .NET 10
      > - Bugfixes:
      >	  - Fixed InvalidOperationException when pressing a Connector (pointer capture reentrancy in WpfControl)
      >	  - Fixed NullReferenceException from null entries in NodifyEditor.SelectedItems
    </PackageReleaseNotes>
    <AssemblyOriginatorKeyFile>..\build\Nodify.snk</AssemblyOriginatorKeyFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <WarningsAsErrors>$(WarningsAsErrors),AVP1000, AVP1001, AVP1002, AVP1010, AVP1011, AVP1012, AVP1013, AVP1020, AVP1021, AVP1022, AVP1030, AVP1031, AVP1032, AVP1040, AVA2001</WarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <SignAssembly>true</SignAssembly>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Themes\*.xaml" />
    <AvaloniaResource Include="Themes\*.xaml" />
    <None Remove="Themes\Styles\*.xaml" />
    <AvaloniaResource Include="Themes\Styles\*.xaml" />
  </ItemGroup>
  
</Project>
